    <resource methods="POST" uri-template="/div">
        <inSequence>
            <property name="operation" value="div" scope="default" type="STRING"/>
            <property name="intA" scope="default" type="STRING" expression="json-eval($.intA)"/>
            <property name="intB" scope="default" type="STRING" expression="json-eval($.intB)"/>
            <payloadFactory media-type="xml" template-type="default">
                <format>
                    <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
                        <soapenv:Header/>
                        <soapenv:Body>
                            <tem:Divide>
                                <tem:intA>$1</tem:intA>
                                <tem:intB>$2</tem:intB>
                            </tem:Divide>
                        </soapenv:Body>
                    </soapenv:Envelope>
                </format>
                <args>
                    <arg evaluator="xml" expression="get-property('intA')"/>
                    <arg evaluator="xml" expression="get-property('intB')"/>
                </args>
            </payloadFactory>
            <call>
                <endpoint key="calc-Ep"/>
            </call>
            <filter source="get-property('axis2','HTTP_SC')" regex="2\d\d">
                <then>
                    <property name="NO_ENTITY_BODY" scope="axis2" action="remove"/>
                    <payloadFactory media-type="json" template-type="default">
                        <format>{result: "$1"
                            }</format>
                        <args>
                            <arg xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:ns="http://tempuri.org/" evaluator="xml" expression="//soap:Body/ns:DivideResponse/ns:DivideResult/text()"/>
                        </args>
                    </payloadFactory>
                    <sequence key="LogCalcSequence"/>
                    <respond/>
                </then>
                <else>
                    <property name="errorMsg" expression="//*[local-name()='faultstring']/text()" scope="default" type="STRING"/>
                    <sequence key="LogCalcErrorSequence"/>
                    <payloadFactory media-type="json">
                        <format>{"error": "$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('errorMsg')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" value="400" scope="axis2"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <property name="errorMsg" expression="get-property('ERROR_MESSAGE')" scope="default" type="STRING"/>
            <sequence key="LogCalcErrorSequence"/>
            <payloadFactory media-type="json">
                <format>{"error": "$1"}</format>
                <args>
                    <arg evaluator="xml" expression="get-property('errorMsg')"/>
                </args>
            </payloadFactory>
            <property name="HTTP_SC" value="502" scope="axis2"/>
            <respond/>
        </faultSequence>
    </resource>
    <resource methods="GET" uri-template="/history/{id}">
        <inSequence>
            <dblookup>
                <connection>
                    <pool>
                        <dsName>jdbc/CALC_DB</dsName>
                    </pool>
                </connection>
                <statement>
                    <sql><![CDATA[SELECT operation, int_a, int_b, result, status FROM calc_log WHERE id = ?]]></sql>
                    <parameter expression="get-property('uri.var.id')" type="INTEGER"/>
                    <result name="h_op" column="operation"/>
                    <result name="h_a" column="int_a"/>
                    <result name="h_b" column="int_b"/>
                    <result name="h_result" column="result"/>
                    <result name="h_status" column="status"/>
                </statement>
            </dblookup>
            <property name="NO_ENTITY_BODY" scope="axis2" action="remove"/>
            <filter xpath="string-length(get-property('h_op')) = 0">
                <then>
                    <payloadFactory media-type="json">
                        <format>{"error":"NOT_FOUND","id":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('uri.var.id')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" value="404" scope="axis2"/>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>{"operation":"$1","intA":"$2","intB":"$3","result":"$4","status":"$5"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('h_op')"/>
                            <arg evaluator="xml" expression="get-property('h_a')"/>
                            <arg evaluator="xml" expression="get-property('h_b')"/>
                            <arg evaluator="xml" expression="get-property('h_result')"/>
                            <arg evaluator="xml" expression="get-property('h_status')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
        </faultSequence>
    </resource>
</api>